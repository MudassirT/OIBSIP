# PizzaForge Client Environment Configuration
# API Backend Base URL
VITE_API_BASE_URL=http://localhost:5000/api

# Real-Time WebSocket Server URL
VITE_SOCKET_URL=http://localhost:5000

# Razorpay Test Mode Public Key ID (Safe to expose on client-side)
# Obtain from Razorpay Dashboard -> Settings -> API Keys (Test mode)
VITE_RAZORPAY_KEY_ID=rzp_test_sample_key_id
