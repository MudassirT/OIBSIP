# Server Environment Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database Connection (MongoDB Atlas or local URI)
# If left blank or unreachable in development, PizzaForge safely falls back to an embedded in-memory MongoDB instance
MONGO_URI=mongodb://localhost:27017/pizzaforge

# JWT Authentication
JWT_SECRET=super_secret_pizzaforge_jwt_key_32_chars_minimum_here!
JWT_EXPIRES_IN=1d

# Default Admin Credentials (used during seed script execution)
ADMIN_NAME=Admin Manager
ADMIN_EMAIL=admin@pizzaforge.com
ADMIN_PASSWORD=Admin@123456

# Razorpay Test Mode Credentials
# Get these free at https://dashboard.razorpay.com/ -> Settings -> API Keys (Test mode)
RAZORPAY_KEY_ID=rzp_test_sample_key_id
RAZORPAY_KEY_SECRET=sample_key_secret_for_test

# Email Notifications (Nodemailer SMTP)
# If not configured, development mode gracefully generates Ethereal test accounts or prints email preview links to console
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="PizzaForge Kitchen" <noreply@pizzaforge.com>

# Low Stock Cron Schedule
# Default: Hourly ("0 * * * *"). For rapid testing/demos, use every minute: "* * * * *"
CRON_SCHEDULE=0 * * * *
