{
  "name": "pizzaforge-monorepo",
  "version": "1.0.0",
  "description": "PizzaForge - Production-style Pizza Delivery and Inventory Platform",
  "scripts": {
    "install:all": "npm install --prefix server && npm install --prefix client",
    "seed": "npm run seed --prefix server",
    "dev:server": "npm run dev --prefix server",
    "dev:client": "npm run dev --prefix client",
    "dev": "concurrently -n \"SERVER,CLIENT\" -c \"cyan,magenta\" \"npm run dev:server\" \"npm run dev:client\"",
    "start": "npm run dev",
    "test:suite": "node server/tests/runAllTests.js"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  },
  "keywords": [
    "pizzaforge",
    "oasis-infobyte",
    "mern",
    "fullstack"
  ],
  "author": "Mudassir Ahmed",
  "license": "ISC"
}
